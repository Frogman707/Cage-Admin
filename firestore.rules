rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Staff records include a plaintext PIN and TOTP secret. Direct client access is denied
    // entirely - the only paths to this collection are the listStaffNames (public, names only)
    // and staffLogin (verifies PIN+TOTP server-side, never returns them) Cloud Functions, using
    // the Admin SDK, which bypasses these rules. Once staffLogin succeeds, the client signs in
    // with the custom token it returns, which is what request.auth != null below is checking for.
    match /staff/{staffId} {
      allow read, write: if request.auth != null;
    }

    // Firestore ORs every matching `match` block together for a given path - a plain
    // `match /{document=**} { allow read, write: if true; }` here would also match every /staff/*
    // document and silently cancel the restriction above out (true OR anything is true). The
    // path[0] != 'staff' guard excludes staff paths from this catch-all so the rule above is the
    // one that actually governs them.
    //
    // Every other collection keeps the app's current behavior (no auth system covers these yet -
    // see the project engineering review, Track B) - unrestricted, matching what was already
    // effectively the case before this file existed (no rules file meant Firestore's default
    // test-mode rules applied). Tightening these requires moving their reads/writes behind a
    // server API the same way staff was, tracked separately.
    match /{path=**} {
      allow read, write: if path[0] != 'staff';
    }
  }
}
